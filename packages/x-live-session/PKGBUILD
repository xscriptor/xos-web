# Maintainer: Xscriptor <dev@xscriptor.com>
pkgname=x-live-session
pkgver=1.0
pkgrel=1
pkgdesc="X Linux live graphical session (openbox + pcmanfm + installer icon)"
arch=('any')
url="https://xscriptor.io/x"
license=('GPL-3.0-or-later')
depends=('x-release' 'xorg-server' 'xorg-xinit' 'xorg-xrandr'
         'openbox' 'pcmanfm' 'mesa' 'xf86-video-vesa' 'feh'
         'dbus' 'zenity')
source=()
sha256sums=()

package() {
    install -Dm755 "$startdir/files/usr/bin/x-live-session" "$pkgdir/usr/bin/x-live-session"
    install -Dm755 "$startdir/files/usr/bin/x-installer" "$pkgdir/usr/bin/x-installer"
    install -Dm644 "$startdir/files/usr/share/applications/x-installer.desktop" "$pkgdir/usr/share/applications/x-installer.desktop"
    install -Dm644 "$startdir/files/etc/xdg/openbox/autostart" "$pkgdir/etc/xdg/openbox/autostart"
    install -Dm644 "$startdir/files/etc/xdg/openbox/rc.xml" "$pkgdir/etc/xdg/openbox/rc.xml"

    # Desktop icon (Instalar X) placed on the live desktop via pcmanfm profile
    install -Dm644 "$startdir/files/usr/share/applications/x-installer.desktop" "$pkgdir/etc/skel/Desktop/x-installer.desktop"

    # pcmanfm live desktop profile
    install -d "$pkgdir/etc/skel/.config/pcmanfm/x-live"
    install -Dm644 /dev/stdin "$pkgdir/etc/skel/.config/pcmanfm/x-live/pcmanfm.conf" <<'EOF'
[desktop]
wallpaper_mode=stretch
wallpaper=/usr/share/backgrounds/x/x-wallpaper.png
desktop_font=Noto Sans 10
show_documents=0
show_trash=0
show_mounts=0
single_click=0

[panel]
icons=4
EOF
}
