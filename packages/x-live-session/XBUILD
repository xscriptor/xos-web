[package]
name = "x-live-session"
version = "1.0"
release = 3
description = "X Linux live graphical session (openbox + pcmanfm + installer icon)"
url = "https://xscriptor.io/x"
license = ["GPL-3.0-or-later"]
arch = ["any"]

[dependencies]
depends = ["x-release", "xorg-server", "xorg-xinit", "xorg-xrandr",
           "openbox", "pcmanfm", "mesa", "xf86-video-vesa", "feh",
           "dbus", "zenity"]

[source]
urls = []

[build]
package = """
install -Dm755 "$startdir/files/usr/bin/x-live-session" "$PKGDIR/usr/bin/x-live-session"
install -Dm755 "$startdir/files/usr/bin/x-installer" "$PKGDIR/usr/bin/x-installer"

# openbox config (copied to ~/.config/openbox at live startup)
install -Dm644 "$startdir/files/usr/share/x-live-session/openbox/autostart" "$PKGDIR/usr/share/x-live-session/openbox/autostart"
install -Dm644 "$startdir/files/usr/share/x-live-session/openbox/rc.xml" "$PKGDIR/usr/share/x-live-session/openbox/rc.xml"

# pcmanfm desktop profile + desktop icon (copied to /root at live startup)
install -Dm644 "$startdir/files/usr/share/x-live-session/pcmanfm/x-live/pcmanfm.conf" "$PKGDIR/usr/share/x-live-session/pcmanfm/x-live/pcmanfm.conf"
install -Dm644 "$startdir/files/usr/share/x-live-session/pcmanfm/x-live/x-installer.desktop" "$PKGDIR/usr/share/x-live-session/pcmanfm/x-live/x-installer.desktop"
"""
