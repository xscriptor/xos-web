#!/usr/bin/env bash
set -euo pipefail

# X Linux — launch the Calamares installer from the live session.
LOG="/tmp/x-installer.log"
echo "[x-installer] starting at $(date)" > "$LOG"

if ! command -v calamares >/dev/null 2>&1; then
    echo "[x-installer] calamares not found" >> "$LOG"
    zenity --error --title="X Linux" --text="Calamares no está instalado en el live." 2>/dev/null \
        || echo "[x] calamares not found in live environment."
    exit 1
fi

# Use a DBus session so Calamares can talk to polkit/etc.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    eval "$(dbus-launch --sh-syntax)" 2>/dev/null || true
fi

# Software rendering: required on VMs without GPU (Qt6/QML fails to init GL).
export QT_QUICK_BACKEND=software
export LIBGL_ALWAYS_SOFTWARE=1
export QT_QPA_PLATFORM=xcb

echo "[x-installer] launching calamares..." >> "$LOG"
echo "  DISPLAY=$DISPLAY" >> "$LOG"
echo "  DBUS=$DBUS_SESSION_BUS_ADDRESS" >> "$LOG"

# Installer runs as root (live autologin is root); Calamares supports this.
exec calamares --debug 2>>"$LOG"
