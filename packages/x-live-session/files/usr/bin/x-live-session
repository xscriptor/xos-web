#!/usr/bin/env bash
set -euo pipefail

# X Linux — start the graphical live session (openbox + pcmanfm + installer icon).

# Only on tty1, root autologin.
[ "$(tty)" = "/dev/tty1" ] || exit 0
[ "$(id -u)" = "0" ] || exit 0

# Live environment check.
IS_LIVE=0
grep -q "/run/archiso/bootmnt" /proc/mounts 2>/dev/null && IS_LIVE=1
[ -d /run/archiso/airootfs ] && IS_LIVE=1
grep -Eq 'archisobasedir=|archisosearchuuid=|script=' /proc/cmdline && IS_LIVE=1
[ "$IS_LIVE" = "0" ] && exit 0

# Cancel hook (kernel cmdline x_nogui=1).
[ "${x_NO_AUTO:-0}" = "1" ] && exit 0
grep -q "x_nogui=1" /proc/cmdline && exit 0

echo
echo "──────────────────────────────────────────"
echo "   X Linux — Iniciando el instalador gráfico"
echo "   (Instala X desde el icono del escritorio)"
echo "──────────────────────────────────────────"

# udev settle so Xorg finds the devices.
command -v udevadm >/dev/null 2>&1 && udevadm settle || true

# Ensure the branding package is present.
if ! pacman -Qq x-release >/dev/null 2>&1; then
    echo "[x] x-release no está instalado en el live."
fi

# Install X configs into the root user's home (live session runs as root).
# openbox reads ~/.config/openbox before /etc/xdg/openbox.
if [ -d /usr/share/x-live-session/openbox ]; then
    mkdir -p /root/.config/openbox
    cp -f /usr/share/x-live-session/openbox/autostart /root/.config/openbox/autostart
    cp -f /usr/share/x-live-session/openbox/rc.xml /root/.config/openbox/rc.xml
fi

# pcmanfm desktop profile + desktop icon (Instalar X).
if [ -d /usr/share/x-live-session/pcmanfm/x-live ]; then
    mkdir -p /root/.config/pcmanfm/x-live /root/Desktop
    cp -f /usr/share/x-live-session/pcmanfm/x-live/pcmanfm.conf /root/.config/pcmanfm/x-live/pcmanfm.conf
    cp -f /usr/share/x-live-session/pcmanfm/x-live/x-installer.desktop /root/Desktop/x-installer.desktop
    chmod +x /root/Desktop/x-installer.desktop
fi

# Silence xauth warnings in the openbox autostart.
touch /root/.Xauthority 2>/dev/null || true

# DBus session bus.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    eval "$(dbus-launch --sh-syntax)" 2>/dev/null || true
fi

# Launch X with openbox.
exec startx /usr/bin/openbox-session -- -quiet -nolisten tcp
